<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:models="clr-namespace:UniCar.Mobile.Models" x:Class="UniCar.Mobile.Pages.ActivitiesPage" BackgroundColor="White" SafeAreaEdges="Container" Shell.NavBarIsVisible="False">
 <Grid Padding="24,16" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="16">
  <Grid ColumnDefinitions="*,Auto"><Label Text="Atividades" Style="{StaticResource TitleLabel}"/><Button Grid.Column="1" Text="Atualizar" Style="{StaticResource TextButton}" Clicked="OnRefresh"/></Grid>
  <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="8"><Button x:Name="TripsTab" Text="Viagens" CommandParameter="trips" Style="{StaticResource SelectedOptionButton}" Clicked="OnTab"/><Button x:Name="ProposalsTab" Grid.Column="1" Text="Propostas" CommandParameter="proposals" Style="{StaticResource OptionButton}" Clicked="OnTab"/></Grid>
  <VerticalStackLayout Grid.Row="2" Spacing="8"><ActivityIndicator x:Name="Loading" Color="{StaticResource Brand}"/><Label x:Name="StateLabel" FontSize="14" TextColor="{StaticResource Grey700}" IsVisible="False"/></VerticalStackLayout>
  <Grid Grid.Row="3" RowDefinitions="*,Auto">
   <CollectionView x:Name="TripList" SelectionMode="None"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate x:DataType="models:ActivityTripDto">
    <Border Padding="16" Stroke="{StaticResource Grey200}" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="8">
     <Label Text="{Binding PersonLabel}" FontAttributes="Bold" TextColor="{StaticResource Brand}" FontSize="16"/><Label Text="{Binding RideSummary.Route}" TextColor="{StaticResource Brand}" FontSize="15"/><Label Text="{Binding RideSummary.DateLabel}" TextColor="{StaticResource Grey700}" FontSize="13"/><Label Text="{Binding StatusLabel}" TextColor="{StaticResource Grey700}"/><Label Text="{Binding PriceLabel}" TextColor="{StaticResource Brand}"/>
     <Button Text="Ver detalhes" Style="{StaticResource TextButton}" Clicked="OnTrip" CommandParameter="{Binding .}"/>
    </VerticalStackLayout></Border>
   </DataTemplate></CollectionView.ItemTemplate></CollectionView>
   <CollectionView x:Name="ProposalList" IsVisible="False" SelectionMode="None"><CollectionView.ItemsLayout><LinearItemsLayout Orientation="Vertical" ItemSpacing="12"/></CollectionView.ItemsLayout><CollectionView.ItemTemplate><DataTemplate x:DataType="models:NegotiationDto">
    <Border Padding="16" Stroke="{StaticResource Grey200}" StrokeShape="RoundRectangle 8"><VerticalStackLayout Spacing="8"><Label Text="{Binding Title}" FontAttributes="Bold" TextColor="{StaticResource Brand}"/><Label Text="{Binding RideSummary.Route}" TextColor="{StaticResource Brand}"/><Label Text="{Binding RideSummary.DateLabel}" TextColor="{StaticResource Grey700}"/><Label Text="{Binding StatusLabel}" TextColor="{StaticResource Grey700}"/><Button Text="Ver proposta" Style="{StaticResource SecondaryButton}" CommandParameter="{Binding .}" Clicked="OnProposal"/></VerticalStackLayout></Border>
   </DataTemplate></CollectionView.ItemTemplate></CollectionView>
   <Button Grid.Row="1" x:Name="MoreButton" Text="Carregar mais" IsVisible="False" Style="{StaticResource TextButton}" Clicked="OnMore"/>
  </Grid>
 </Grid>
</ContentPage>
