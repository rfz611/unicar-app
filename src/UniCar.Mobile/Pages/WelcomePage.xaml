<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniCar.Mobile.Pages.WelcomePage"
             BackgroundColor="{StaticResource Brand}"
             SafeAreaEdges="Container"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto" Padding="24,16,24,24">

        <VerticalStackLayout Grid.Row="0" VerticalOptions="Center" Spacing="28">

            <Image Source="logo_white.png"
                   HeightRequest="96"
                   Aspect="AspectFit"
                   HorizontalOptions="Start"
                   SemanticProperties.Description="UniCar" />

            <Label Text="Caronas entre universitários, no seu caminho."
                   TextColor="#C9D4EA"
                   FontSize="20" />

            <!-- Motivo visual: origem (círculo) → destino (quadrado), como o trajeto do Uber -->
            <Grid ColumnDefinitions="24,*" RowDefinitions="Auto,48,Auto" ColumnSpacing="14" Margin="0,12,0,0">
                <BoxView Grid.RowSpan="3" WidthRequest="2" Color="#4A6BA8"
                         HorizontalOptions="Center" Margin="0,11,0,11" />

                <Border Grid.Row="0" WidthRequest="12" HeightRequest="12" BackgroundColor="White"
                        StrokeThickness="0" StrokeShape="RoundRectangle 6"
                        HorizontalOptions="Center" VerticalOptions="Center" />
                <BoxView Grid.Row="2" WidthRequest="12" HeightRequest="12" Color="White"
                         HorizontalOptions="Center" VerticalOptions="Center" />

                <Label Grid.Row="0" Grid.Column="1" Text="Seu bairro" TextColor="White" FontSize="16" />
                <Label Grid.Row="2" Grid.Column="1" Text="Universidade Positivo" TextColor="White"
                       FontSize="16" FontAttributes="Bold" />
            </Grid>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="12">
            <Button Text="Entrar"
                    Style="{StaticResource LightButton}"
                    Clicked="OnLoginClicked" />
            <Button Text="Criar conta"
                    Style="{StaticResource DarkButton}"
                    Clicked="OnRegisterClicked" />
            <Label Text="Exclusivo para a comunidade da Universidade Positivo."
                   TextColor="#9FB0D3"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   Margin="0,8,0,0" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
