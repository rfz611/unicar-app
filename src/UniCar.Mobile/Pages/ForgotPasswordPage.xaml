<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UniCar.Mobile.Controls"
             x:Class="UniCar.Mobile.Pages.ForgotPasswordPage"
             BackgroundColor="White"
             SafeAreaEdges="Container"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,16,24,16" Spacing="20">

                <controls:BackButton />

                <VerticalStackLayout Spacing="8" Margin="0,12,0,8">
                    <Label Text="Esqueceu sua senha?" Style="{StaticResource TitleLabel}" />
                    <Label Text="Informe seu e-mail institucional e enviaremos um código de 6 dígitos para criar uma nova senha."
                           Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>

                <controls:FormField x:Name="EmailField"
                                    Title="E-mail institucional"
                                    Placeholder="nome@positivo.edu.br"
                                    InputKeyboard="Email" />

                <Border x:Name="ErrorBanner" Style="{StaticResource ErrorBanner}">
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" FontSize="14" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="24,8,24,24">
            <Button x:Name="SendButton"
                    Text="Enviar código"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnSendClicked" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
