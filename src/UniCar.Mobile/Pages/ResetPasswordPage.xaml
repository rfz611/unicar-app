<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:UniCar.Mobile.Controls"
             x:Class="UniCar.Mobile.Pages.ResetPasswordPage"
             BackgroundColor="White"
             SafeAreaEdges="Container"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="24,16,24,16" Spacing="20">

                <controls:BackButton />

                <VerticalStackLayout Spacing="8" Margin="0,12,0,8">
                    <Label Text="Criar nova senha" Style="{StaticResource TitleLabel}" />
                    <Label x:Name="SubtitleLabel" Style="{StaticResource SubtitleLabel}" />
                </VerticalStackLayout>

                <!-- Só aparece com a API em modo Development (não há envio real de e-mail) -->
                <Border x:Name="DevBanner" Style="{StaticResource ErrorBanner}" BackgroundColor="#FFF7E0">
                    <Label x:Name="DevLabel" TextColor="#7A5A00" FontSize="14" />
                </Border>

                <controls:FormField x:Name="CodeField"
                                    Title="Código de 6 dígitos"
                                    Placeholder="000000"
                                    InputKeyboard="Numeric"
                                    MaxLength="6" />

                <controls:FormField x:Name="PasswordField"
                                    Title="Nova senha"
                                    Placeholder="Mínimo de 6 caracteres"
                                    IsPassword="True" />

                <controls:FormField x:Name="ConfirmField"
                                    Title="Confirmar nova senha"
                                    Placeholder="Repita a senha"
                                    IsPassword="True" />

                <Border x:Name="ErrorBanner" Style="{StaticResource ErrorBanner}">
                    <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" FontSize="14" />
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="1" Padding="24,8,24,24" Spacing="16">
            <Button x:Name="ResetButton"
                    Text="Redefinir senha"
                    Style="{StaticResource PrimaryButton}"
                    Clicked="OnResetClicked" />

            <Label HorizontalTextAlignment="Center" FontSize="15" TextColor="#5B6B85">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Não recebeu o código? " />
                        <Span Text="Enviar novamente" TextColor="{StaticResource Brand}" FontAttributes="Bold" />
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnResendTapped" />
                </Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
