<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="UniCar.Mobile.Pages.RoutePickerPage" BackgroundColor="White" SafeAreaEdges="Container">
 <Grid RowDefinitions="Auto,*,Auto" Padding="0,8">
  <Button Text="Cancelar" Style="{StaticResource TextButton}" Clicked="OnCancel" HorizontalOptions="Start" Margin="14,0"/>
  <WebView x:Name="MapWeb" Grid.Row="1" Navigating="OnNavigating" Navigated="OnNavigated"/>
  <VerticalStackLayout Grid.Row="2" Padding="24,8,24,16" Spacing="8"><Label x:Name="RouteLabel" Text="Selecione os pontos e calcule o percurso no mapa." TextColor="{StaticResource Grey700}" FontSize="14"/><Button x:Name="ConfirmButton" Text="Usar percurso" IsEnabled="False" Style="{StaticResource PrimaryButton}" Clicked="OnConfirm"/></VerticalStackLayout>
 </Grid>
</ContentPage>
