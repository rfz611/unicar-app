<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Paleta inspirada no Uber: preto, branco e cinzas neutros -->
    <Color x:Key="Brand">#052355</Color>
    <Color x:Key="BrandPressed">#0B3380</Color>
    <Color x:Key="BrandSoft">#123A78</Color>
    <Color x:Key="Success">#05944F</Color>
    <Color x:Key="SuccessSoft">#E6F4EC</Color>
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Grey100">#F1F4F9</Color>
    <Color x:Key="Grey200">#E8EDF5</Color>
    <Color x:Key="Grey300">#DCE3EF</Color>
    <Color x:Key="Grey500">#8A8A8A</Color>
    <Color x:Key="Grey700">#5B6B85</Color>
    <Color x:Key="Danger">#E11900</Color>
    <Color x:Key="DangerSoft">#FDECEA</Color>

    <!-- Tipografia -->
    <Style x:Key="TitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource Brand}" />
    </Style>

    <Style x:Key="SubtitleLabel" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource Grey700}" />
    </Style>

    <!-- Ação principal da marca -->
    <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource Brand}" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="HeightRequest" Value="52" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="BorderWidth" Value="0" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="#0B3380" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Grey200}" />
                            <Setter Property="TextColor" Value="#AFAFAF" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Botão secundário (cinza claro) -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource Grey200}" />
        <Setter Property="TextColor" Value="{StaticResource Brand}" />
        <Setter Property="VisualStateManager.VisualStateGroups">
            <VisualStateGroupList>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Property="BackgroundColor" Value="{StaticResource Grey300}" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Property="TextColor" Value="#AFAFAF" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateGroupList>
        </Setter>
    </Style>

    <!-- Botão branco (para fundos pretos) -->
    <Style x:Key="LightButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BackgroundColor" Value="{StaticResource White}" />
    </Style>

    <!-- Botão escuro (para fundos pretos) -->
    <Style x:Key="DarkButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BackgroundColor" Value="#123A78" />
        <Setter Property="TextColor" Value="{StaticResource White}" />
    </Style>

    <!-- Links com área de toque e foco de um botão nativo. -->
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style x:Key="OptionButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,0" />
    </Style>
    <Style x:Key="SelectedOptionButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- Aviso de erro -->
    <Style x:Key="ErrorBanner" TargetType="Border">
        <Setter Property="BackgroundColor" Value="{StaticResource DangerSoft}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="IsVisible" Value="False" />
        <Setter Property="StrokeShape" Value="RoundRectangle 8" />
    </Style>

    <!-- Aviso de sucesso -->
    <Style x:Key="SuccessBanner" TargetType="Border" BasedOn="{StaticResource ErrorBanner}">
        <Setter Property="BackgroundColor" Value="{StaticResource SuccessSoft}" />
    </Style>

</ResourceDictionary>
